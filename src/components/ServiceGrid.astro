---
import { href, type Locale } from '../lib/routes';
import { services, common, formatPrice } from '../lib/content';
const { locale } = Astro.props as { locale: Locale };
const c = common(locale);
---
<ul class="grid md:grid-cols-2 lg:grid-cols-4 border-t border-l border-line">
  {services(locale).map((s, i) => (
    <li class="border-b border-r border-line">
      <a href={href(locale, `service-${s.id}`)} class="group flex flex-col h-full md:min-h-[240px] p-5 md:p-6 no-underline hover:bg-mist transition-colors duration-150">
        <span class="text-[15px] tabular-nums muted" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="subtitle mt-6 group-hover:text-purple-ink transition-colors duration-150">{s.name}</h3>
        <p class="muted text-[16px] mt-2">{s.short}</p>
        <p class="mt-auto pt-6 text-[15px] font-medium">{formatPrice(s.id, locale)}</p>
      </a>
    </li>
  ))}
  <li class="border-b border-r border-line">
    <a href={href(locale, 'services')} class="on-dark flex flex-col justify-between gap-8 h-full md:min-h-[240px] p-5 md:p-6 bg-ink text-white no-underline hover:bg-coal transition-colors duration-150">
      <img src="/brand/renee-star-lime-sm.webp" alt="" width="20" height="20" loading="lazy" />
      <span class="subtitle">{c.cta.allServices} →</span>
    </a>
  </li>
</ul>
