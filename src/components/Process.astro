---
const { steps, dark = false } = Astro.props as { steps: { t: string; d: string }[]; dark?: boolean };
const cols = steps.length >= 4 ? 'md:grid-cols-2 lg:grid-cols-4' : 'md:grid-cols-3';
---
<ol class:list={['grid gap-x-6', cols]}>
  {steps.map((s, i) => (
    <li class:list={['border-t pt-4 pb-10', dark ? 'border-white' : 'border-ink']}>
      <span class="text-[15px] tabular-nums muted" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <h3 class="subtitle mt-8">{s.t}</h3>
      <p class="muted mt-3 text-[16px]">{s.d}</p>
    </li>
  ))}
</ol>
