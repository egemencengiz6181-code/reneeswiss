---
import Layout from '../layouts/Layout.astro';
import type { Locale, Route } from '../lib/routes';
const { locale, route, c: p } = Astro.props as { locale: Locale; route: Route; c: any };
import { href, pathOf } from '../lib/routes';
import { common, formatPrice } from '../lib/content';
import { faqLd, serviceLd } from '../lib/schema';
import PageHead from '../components/PageHead.astro';
import Section from '../components/Section.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import CaseCard from '../components/CaseCard.astro';
import FinalCta from '../components/FinalCta.astro';
import CalButton from '../components/CalButton.astro';
const c = common(locale);
const L = c.serviceLabels;
const id = route.param!;
const origin = Astro.site!.origin;
const price = formatPrice(id, locale);
const facts = [[c.facts.who, p.facts.who], [c.facts.what, p.facts.what], [c.facts.price, `${price} ${c.price.vat}`], [c.facts.delivery, p.timeline]];
---
<Layout locale={locale} route={route} meta={p.meta} jsonLd={[serviceLd(origin, pathOf(route, locale), p.name, p.meta.description, id), faqLd(p.faq)]}>
  <PageHead eyebrow={p.name} title={p.h1} lead={p.lead}><div class="mt-8"><CalButton locale={locale} label={c.cta.primary} /></div></PageHead>
  <section class="wrap" aria-label={c.facts.title}>
    <dl class="grid md:grid-cols-2 lg:grid-cols-4 border-t border-ink">
      {facts.map(([k, v]) => <div class="py-4 md:pr-6 border-b lg:border-b-0 border-line"><dt class="muted text-[15px]">{k}</dt><dd class="mt-2 text-[18px] font-medium tracking-tight">{v}</dd></div>)}
    </dl>
  </section>
  <Section><div class="grid-12"><h2 class="title col-span-12 lg:col-span-4">{L.problem}</h2><p class="lead col-span-12 lg:col-start-6 lg:col-span-7 measure mt-4 lg:mt-0">{p.problem}</p></div></Section>
  <Section tone="mist">
    <div class="grid-12">
      <div class="col-span-12 lg:col-span-6"><h2 class="title">{L.included}</h2><ul class="dash-list mt-8">{p.included.map((b: string) => <li>{b}</li>)}</ul></div>
      <div class="col-span-12 lg:col-start-8 lg:col-span-5 mt-12 lg:mt-0"><h2 class="title">{L.deliverables}</h2><ul class="dash-list mt-8">{p.deliverables.map((b: string) => <li>{b}</li>)}</ul></div>
    </div>
  </Section>
  <Section title={L.process}><Process steps={p.process} /></Section>
  <Section tone="mist">
    <div class="grid-12">
      <div class="col-span-12 md:col-span-5 lg:col-span-4"><h2 class="title mb-8">{L.related}</h2><CaseCard locale={locale} id={p.relatedCase} sizes="(min-width:768px) 30vw, 92vw" /></div>
      <div class="col-span-12 md:col-start-7 md:col-span-6 mt-12 md:mt-0"><h2 class="title mb-8">{L.faq}</h2><Faq items={p.faq} /></div>
    </div>
  </Section>
  <FinalCta locale={locale} />
</Layout>
