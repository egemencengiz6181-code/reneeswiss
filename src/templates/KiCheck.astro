---
import Layout from '../layouts/Layout.astro';
import type { Locale, Route } from '../lib/routes';
const { locale, route, c: p } = Astro.props as { locale: Locale; route: Route; c: any };
import PageHead from '../components/PageHead.astro';
import Section from '../components/Section.astro';
import Process from '../components/Process.astro';
import Form from '../components/Form.astro';
---
<Layout locale={locale} route={route} meta={p.meta}>
  <PageHead eyebrow={p.eyebrow} title={p.h1} lead={p.lead}><a class="btn btn-primary mt-8" href="#form">{p.jump}</a></PageHead>
  <Section title={p.why.title} tone="mist"><div class="grid md:grid-cols-3 gap-x-6">{p.why.items.map((w: any) => <div class="border-t border-ink pt-4 pb-8"><h3 class="subtitle">{w.t}</h3><p class="muted mt-3">{w.d}</p></div>)}</div></Section>
  <Section title={p.includes.title}><Process steps={p.includes.steps} /></Section>
  <Section tone="mist">
    <div class="grid-12">
      <div class="col-span-12 lg:col-span-5"><h2 class="title">{p.form.title}</h2><p class="lead mt-6">{p.form.text}</p></div>
      <div class="col-span-12 lg:col-start-7 lg:col-span-6 mt-10 lg:mt-0"><Form locale={locale} type="ki-check" routeId={route.id} /></div>
    </div>
  </Section>
</Layout>
